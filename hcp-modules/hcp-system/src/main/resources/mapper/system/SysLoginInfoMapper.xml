<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hcp.system.mapper.SysLoginInfoMapper">

	<resultMap type="com.hcp.system.api.domain.SysLoginInfo" id="SysLoginInfoResult">
		<id     property="infoId"        column="info_id"           />
		<result property="phone"      column="phone"         />
		<result property="status"        column="status"            />
		<result property="ipaddr"        column="ipaddr"            />
		<result property="msg"           column="msg"               />
		<result property="accessTime"    column="access_time"       />
		<result property="merchantId"    column="merchant_id"       />
	</resultMap>

	<insert id="insertLoginInfo" parameterType="com.hcp.system.api.domain.SysLoginInfo">
		INSERT INTO sys_login_info (phone, status, ipaddr, msg, access_time, merchant_id)
		values (#{phone}, #{status}, #{ipaddr}, #{msg}, sysdate(), #{merchantId})
	</insert>

	<select id="selectLoginInfoList"  resultMap="SysLoginInfoResult">
		select info_id, phone, ipaddr, status, msg, access_time,merchant_id from sys_login_info
		<where>
			<if test="query.ipaddr != null and query.ipaddr != ''">
				AND ipaddr like concat('%', #{query.ipaddr}, '%')
			</if>
			<if test="query.status != null and query.status != ''">
				AND status = #{query.status}
			</if>
			<if test="query.userName != null and query.userName != ''">
				AND user_name like concat('%', #{query.userName}, '%')
			</if>
			<if test="query.phone != null and query.phone != ''">
				AND phone like concat('%', #{query.phone}, '%')
			</if>
			<if test="query.params.beginTime != null and query.params.beginTime != ''">
				AND access_time &gt;= #{query.params.beginTime}
			</if>
			<if test="query.params.endTime != null and query.params.endTime != ''">
				AND access_time &lt;= #{query.params.endTime}
			</if>
		</where>
		order by info_id desc
	</select>
    <select id="countLoginInfo" resultType="java.lang.Object">
		select count(info_id) from sys_login_info where status =0 and msg='登录成功'
	</select>
	<select id="countRegister" resultType="java.lang.Object">
		select count(user_id) from sys_user
	</select>
    <select id="countTenant" resultType="java.lang.Object">
		select count(id) from sys_tenant;
	</select>

    <delete id="deleteLoginInfoByIds" parameterType="Long">
 		delete from sys_login_info where info_id in
 		<foreach collection="array" item="infoId" open="(" separator="," close=")">
 			#{infoId}
        </foreach>
 	</delete>

    <update id="cleanLoginInfo">
        truncate table sys_login_info
    </update>

</mapper>
